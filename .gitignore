# venv + caches
.venv/
__pycache__/
*.pyc
*.pyo

# model artifacts: everything in models/ stays out of git (*.gitkeep keeps the dir).
# torch weights + ONNX sources are the input formats; the OpenVINO IR (.xml/.bin)
# is the runtime format (see requirements.txt for regeneration).
*.pth
*.onnx
*.xml
*.bin

# video + outputs (test.mp4 is the source; annotated outputs + tracks are derivable)
*.mp4
out*/
tracks.json

# run logs: transients from tools/run_test_video.py redirects
*.log
